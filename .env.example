# قاعدة البيانات
DATABASE_URL=postgresql://baradais_user:change_me@localhost:5432/wakalat_baradais

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# تخزين المرفقات الحساسة + روابط موقّعة
LOCAL_STORAGE_PATH=storage/private
SIGNED_URL_SECRET=change_this_signed_url_secret
SIGNED_URL_EXPIRE_SECONDS=600

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# تسجيل الدخول عبر قوقل (اختياري): اتركه فارغاً حتى يُنشأ Client ID
# فعلي من Google Cloud Console لنطاق المشروع الفعلي.
GOOGLE_CLIENT_ID=

# بحث حجوزات الطيران عبر Duffel (اختياري، مجاني للتسجيل على
# https://duffel.com): اتركه فارغاً حتى تتوفر بيانات اعتماد (مفتاح
# duffel_test للتجربة، أو مفتاح إنتاج حقيقي لاحقاً).
DUFFEL_API_KEY=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2

# إرسال إشعارات الإيميل عبر SMTP (اختياري): اتركه فارغاً حتى يتوفر
# حساب SMTP فعلي (Gmail SMTP، SendGrid SMTP relay، أو أي مزوّد آخر).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
